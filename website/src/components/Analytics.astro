---
// 仅在 FTL 站点维护者明确配置自己的分析服务时启用。
import { OpenPanelComponent } from '@openpanel/astro';
const apiUrl = import.meta.env.PUBLIC_FTL_ANALYTICS_URL;
const clientId = import.meta.env.PUBLIC_FTL_ANALYTICS_CLIENT_ID;
---
{apiUrl && clientId && <OpenPanelComponent
  apiUrl={apiUrl}
  clientId={clientId}
  trackScreenViews={true}
  trackOutgoingLinks={true}
/>}
