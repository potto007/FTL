diff --git a/tests/test_sampling.py b/tests/test_sampling.py
index 5a39f9a..336a034 100644
--- a/tests/test_sampling.py
+++ b/tests/test_sampling.py
@@ -40,3 +40,56 @@ def test_masked_topk_arrays_no_mask_full_width():
     vals = top_logprobs.tolist()[0]
     assert abs(vals[0] - (2.0 - z)) < 1e-4
     assert abs(vals[2] - (0.5 - z)) < 1e-4
+
+
+def test_sample_tokens_without_sampler_is_greedy():
+    from dflash_mlx.engine.sampling import sample_tokens_with_mask
+
+    logits = mx.array([[0.0, 3.0, 1.0, 2.0], [5.0, 4.0, 3.0, 2.0]])
+    suppress = mx.array([False, True, False, False])
+    sampled = sample_tokens_with_mask(logits, suppress, None)
+    assert sampled.tolist() == greedy_tokens_with_mask(logits, suppress).tolist()
+
+
+def test_make_target_sampler_greedy_params_return_none():
+    from dflash_mlx.engine.sampling import SamplingParams, make_target_sampler
+
+    assert make_target_sampler(None) is None
+    assert make_target_sampler(SamplingParams(temperature=0.0, top_k=20)) is None
+    assert make_target_sampler(SamplingParams(temperature=0.6)) is not None
+
+
+def test_sample_tokens_respects_mask_and_top_k_per_row():
+    from dflash_mlx.engine.sampling import (
+        SamplingParams,
+        make_target_sampler,
+        sample_tokens_with_mask,
+    )
+
+    mx.random.seed(0)
+    logits = mx.array([[0.0, 3.0, 2.9, 2.8, -1.0]] * 64)
+    suppress = mx.array([False, True, False, False, False])
+    sampler = make_target_sampler(SamplingParams(temperature=1.0, top_k=2))
+    tokens = sample_tokens_with_mask(logits, suppress, sampler).tolist()
+    # id 1 is suppressed, top-2 of the rest is {2, 3}; both should appear.
+    assert set(tokens) == {2, 3}
+
+
+def test_sample_tokens_matches_softmax_distribution():
+    from dflash_mlx.engine.sampling import (
+        SamplingParams,
+        make_target_sampler,
+        sample_tokens_with_mask,
+    )
+
+    mx.random.seed(1)
+    temp = 0.6
+    row = [1.0, 0.5, 0.0, -0.5]
+    logits = mx.array([row] * 20000)
+    sampler = make_target_sampler(SamplingParams(temperature=temp))
+    tokens = sample_tokens_with_mask(logits, None, sampler).tolist()
+    weights = [math.exp(v / temp) for v in row]
+    total = sum(weights)
+    for token_id, weight in enumerate(weights):
+        freq = tokens.count(token_id) / len(tokens)
+        assert abs(freq - weight / total) < 0.015
