+@dataclass(frozen=True)
+class SamplingParams:
+    """Request sampling knobs applied to target logits during verify.
+
+    Mirrors mlx-lm's ``make_sampler`` arguments so sampled DFlash draws from
+    the same filtered distribution as target-only AR.
+    """
+
+    temperature: float = 0.0
+    top_p: float = 1.0
+    top_k: int = 0
+    min_p: float = 0.0
+
+    @property
+    def is_greedy(self) -> bool:
+        return float(self.temperature) <= 0.0
+
+
+def make_target_sampler(
+    params: SamplingParams | None,
+) -> Callable[[mx.array], mx.array] | None:
+    """Return an mlx-lm sampler for ``params``, or None for greedy decoding."""
+    if params is None or params.is_greedy:
+        return None
+    from mlx_lm.sample_utils import make_sampler
+
+    return make_sampler(
+        temp=float(params.temperature),
+        top_p=float(params.top_p),
+        min_p=float(params.min_p),
+        top_k=int(params.top_k),
+    )
+
+
+def sample_tokens_with_mask(
+    logits: mx.array,
+    suppress_token_mask: mx.array | None,
+    sampler: Callable[[mx.array], mx.array] | None,
+) -> mx.array:
+    """Pick one token per row of ``logits``: argmax when ``sampler`` is None,
+    otherwise an independent draw per row from the sampler's distribution.
+
+    Verify then accepts the longest draft prefix that matches these tokens and
+    commits the token at the first mismatch, so the output follows the
+    target's sampling distribution exactly (same scheme as mlx-lm's
+    ``speculative_generate_step``).
+    """
+    if sampler is None:
+        return greedy_tokens_with_mask(logits, suppress_token_mask)
+    logits = logits.astype(mx.float32)
+    if suppress_token_mask is not None:
+        logits = mx.where(suppress_token_mask, mx.array(-float("inf"), mx.float32), logits)
+    logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+    return sampler(logprobs).astype(mx.uint32)
+
+
 def masked_topk_arrays(
     logits_2d: mx.array,
     suppress_token_mask: mx.array | None,
