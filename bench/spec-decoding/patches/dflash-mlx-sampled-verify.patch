+def _sampling_params(args: Any) -> SamplingParams | None:
+    sampling = getattr(args, "sampling", None)
+    if sampling is None:
+        return None
+    params = SamplingParams(
+        temperature=float(getattr(sampling, "temperature", 0.0) or 0.0),
+        top_p=float(getattr(sampling, "top_p", 1.0) or 0.0),
+        top_k=int(getattr(sampling, "top_k", 0) or 0),
+        min_p=float(getattr(sampling, "min_p", 0.0) or 0.0),
+    )
+    return None if params.is_greedy else params
